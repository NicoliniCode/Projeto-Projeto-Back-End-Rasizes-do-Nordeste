# Banco disponível via docker compose up -d
DATABASE_URL = "postgresql://raizes:raizes_local@localhost:5432/raizes?schema=public"
PORT = 3000
NODE_ENV = development
# Troque por uma string aleatória longa para uso real (mínimo 32 caracteres).
JWT_SECRET = "TROQUE_ESTE_SEGREDO_POR_UMA_CHAVE_ALEATORIA_LONGA_123"
JWT_EXPIRES_IN = 2h
# true somente no ambiente de demonstração: habilita pagamento fictício
MOCK_PAYMENTS_ENABLED = true
